@page "/"
@using RomanMatrixBuilder.Components
@using RomanMatrixBuilder.Models
@using RomanMatrixBuilder.Services
@inject GameStateService GameState
@inject ProblemGenerator Generator
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>RomanMatrixBuilder</PageTitle>

@* キーボードイベントを補足するためのダミーインプットではなく、Window レベルで JSInterop 経由で補足する仕組みを想定 *@
<div class="app-container" tabindex="0" @ref="containerRef" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="true">

    <div class="top-area">
        <div class="target-panel">
            @if (GameState.IsSessionComplete)
            {
                <div class="message" style="display:none;"></div>
            }
            else if (CurrentProblem != null)
            {
                <div class="hiragana">@CurrentProblem.Hiragana</div>
                <div class="romaji">
                    @* すでに入力された部分と未入力部分を分ける等 *@
                    <span class="typed">@GetTypedPortion()</span><span class="untyped">@GetUntypedPortion()</span>
                </div>
            }
            else if (!IsTransitioning)
            {
                <div class="message">スペースキーを押して開始！</div>
            }
        </div>

        <MatrixDisplay AcquiredSyllables="AcquiredPoints" />
    </div>

    <div class="middle-area">
        <div class="combo-display">
            コンボ: @(new string('★', GameState.CurrentCombo))
            @if (GameState.CurrentCombo == 0)
            {
                <span>☆</span>
            }
        </div>
    </div>

    <div class="bottom-area">
        @if (GameState.IsSessionComplete)
        {
            <!-- ダッシュボードを画面全体に被せるのではなく、このままエリアをハックして表示する簡易実装（PWAとしてはオーバーレイの方がきれいだが今回はコンポーネント入れ替えで） -->
            <div style="position: absolute; top:0; left:0; width:100vw; height:100vh; z-index: 100;">
                <Dashboard OnNextSessionRequest="StartNextSession" />
            </div>
        }
        else
        {
            <VirtualKeyboard State="Keyboard" />
        }
    </div>

</div>

@code {
    private ElementReference containerRef;
    private KeyboardState Keyboard = new();
    private TypingProblem? CurrentProblem;
    private HashSet<string> AcquiredPoints = new();
    private bool IsTransitioning = false;

    private string CurrentInputBuffer = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ローカルストレージから直前の状態を復元
            GameState.LoadData();
            StateHasChanged();
            // コンテナにフォーカスを当ててキーボードイベントを受け取れるようにする
            await JS.InvokeVoidAsync("focusElement", containerRef);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // 遷移中は何もしない
        if (IsTransitioning) return;

        // ダッシュボード表示中：Space/Enterで次のセッションへ
        if (GameState.IsSessionComplete)
        {
            if (e.Key == " " || e.Key == "Enter")
            {
                GameState.ResetSession();
                StartNextSession();
            }
            return;
        }

        if (e.Key == " " && CurrentProblem == null)
        {
            StartNewProblem();
            return;
        }

        if (CurrentProblem == null) return;

        var inputChar = e.Key.ToUpperInvariant();
        if (inputChar.Length != 1 || inputChar[0] < 'A' || inputChar[0] > 'Z') return;

        CurrentInputBuffer += inputChar;

        // すべての許可パターンのうち、現在の入力バッファで始まっているものがあるかチェック
        var matchingPatterns = CurrentProblem.AllowedRomajiList
        .Where(p => p.StartsWith(CurrentInputBuffer))
        .ToList();

        if (matchingPatterns.Any())
        {
            // 正解ルートに乗っている
            Keyboard.HasError = false;
            GameState.RegisterKeystroke(true);

            // 完全に一致するパターンがあれば正解
            if (matchingPatterns.Any(p => p == CurrentInputBuffer))
            {
                // 正解！
                try { _ = JS.InvokeVoidAsync("playAudio", "sound-correct"); } catch { }

                // 正解の文字（母音）を取得してMatrixのキーにする
                var vowel = CurrentProblem.PrimaryRomaji.Last().ToString();
                AcquiredPoints.Add($"{CurrentProblem.MatrixRow}{vowel}");

                GameState.AddCombo();
                GameState.GoalProblem(CurrentProblem.PrimaryRomaji);

                if (GameState.IsSessionComplete)
                {
                    CurrentProblem = null; // リザルト表示待ち状態に
                                           // 画面の再描画で Dashboard が表示される
                }
                else
                {
                    await TransitionToNewProblem();
                }
            }
            else
            {
                // まだ途中。最短の正解パターンから次のキーを推測表示
                var nextPattern = matchingPatterns.OrderBy(p => p.Length).First();
                Keyboard.ExpectedKey = nextPattern[CurrentInputBuffer.Length].ToString();
                Keyboard.NavigationTargetKey = Keyboard.ExpectedKey;
            }
        }
        else
        {
            // いずれのパターンにもマッチしない＝エラー
            Keyboard.HasError = true;
            Keyboard.LastErrorKey = inputChar;
            GameState.RegisterKeystroke(false);

            try { _ = JS.InvokeVoidAsync("playAudio", "sound-error"); } catch { }

            GameState.ResetCombo();
            CurrentInputBuffer = CurrentInputBuffer.Substring(0, CurrentInputBuffer.Length - 1); // ロールバック

            // エラー後は Primary のルートを再提示する
            Keyboard.ExpectedKey = CurrentProblem.PrimaryRomaji[CurrentInputBuffer.Length].ToString();
            Keyboard.NavigationTargetKey = ""; // エラー時は黄色を消して緑点滅のみ
        }
    }

    private void StartNewProblem()
    {
        CurrentInputBuffer = "";
        Keyboard.HasError = false;

        CurrentProblem = Generator.GenerateProblem(GameState.CurrentStage, GameState.CharacterCorrectCounts);

        Keyboard.ExpectedKey = CurrentProblem.PrimaryRomaji[0].ToString();
        Keyboard.NavigationTargetKey = Keyboard.ExpectedKey;
    }

    private async Task TransitionToNewProblem()
    {
        IsTransitioning = true;
        // 一旦画面をクリアして「次の問題」であることを視覚的に伝える
        CurrentProblem = null;
        StateHasChanged();

        await Task.Delay(250); // 250msのタメを作る

        StartNewProblem();
        IsTransitioning = false;
        StateHasChanged();
    }

    private void StartNextSession()
    {
        // Session は Dashboard 側ですでに Reset されている前提、またはここで Reset
        CurrentProblem = null;
        // 次の問題をすぐに開始するか、スペースキー待ちにするか。ここではすぐ開始する
        StartNewProblem();
    }

    private string GetTypedPortion() => CurrentProblem != null ? CurrentInputBuffer : "";
    private string GetUntypedPortion()
    {
        if (CurrentProblem == null) return "";
        // Untyped部分は、PrimaryRomajiをベースに表示する（実際の入力が訓令式等に分岐した場合の対応は複雑になるため簡易化）
        if (CurrentProblem.PrimaryRomaji.StartsWith(CurrentInputBuffer))
        {
            return CurrentProblem.PrimaryRomaji.Substring(CurrentInputBuffer.Length);
        }
        return CurrentProblem.PrimaryRomaji.Substring(Math.Min(CurrentInputBuffer.Length, CurrentProblem.PrimaryRomaji.Length));
    }

    public void Dispose()
    {
        // cleanup
    }
}
